  "initial_source": "def parse_pairs(text):\n    return dict(item.split(':') for item in text.split(','))\n",
  "final_source": "def parse_pairs(text):\n    if not text or text.strip() == \"\":\n        return {}\n    result = {}\n    for item in text.split(\",\"):\n        item = item.strip()\n        if not item:\n            continue\n        if \":\" not in item:\n            raise ValueError(\"Missing colon\")\n        key, value = item.split(\":\", 1)\n        key = key.strip()\n        value = value.strip()\n        if not key:\n            raise ValueError(\"Empty key\")\n        result[key] = value\n    return result\n",
